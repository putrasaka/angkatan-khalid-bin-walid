# Neon Postgres (WAJIB) — connection string dari Neon Console → Connect
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://..."

# Jika kosong, app otomatis fallback ke data dummy lokal (mode demo tanpa DB)
# SQL schema & seed ada di: db/schema.sql & db/seed.sql

# WAJIB untuk token pengunjung + tanda tangan URL video (64 karakter hex)
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VISITOR_TOKEN_SECRET="64-karakter-hex"
